class Solution {
    public int[] findErrorNums(int[] nums) {
        HashSet<Integer> set=new HashSet<>();
        int d=0;
        int m=0;
        for(int num:nums){
            if(set.contains(num)){
                d=num;
            }
            set.add(num);
        }
        for(int i=1;i<=nums.length;i++){
            if(!set.contains(i)){
                m=i;
                break;
            }
        }
       return new int[]{d,m};
    }
}
